# Copy to ".env" and fill in. NEVER commit ".env".

# Same Atlas cluster as your other projects, but a NEW database name (/vyloc)
MONGODB_URI=mongodb://<db_user>:<db_password>@<hosts>/vyloc?ssl=true&authSource=admin

# 5002 so it does not clash with your other APIs (5000, 5001)
PORT=5002

# Random string, 32+ chars. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_characters

# Allowed frontend origins, comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Run checks inside the server process (default: on in development, off in production)
# ENABLE_SCHEDULER=true

# --- Optional: email alerts and sign-up confirmation (Brevo). Leave blank to disable. ---
# BREVO_API_KEY=your_brevo_api_key
# EMAIL_FROM=the_sender_address_you_verified_in_brevo@example.com
# EMAIL_FROM_NAME=VYLOC
# APP_URL=https://your-app.vercel.app
